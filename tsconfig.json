{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@research-workbench/contracts": ["packages/contracts/src/index.ts"],
      "@research-workbench/domain": ["packages/domain/src/index.ts"],
      "@research-workbench/research-skills": ["packages/research-skills/src/index.ts"],
      "@research-workbench/agent-runtime": ["packages/agent-runtime/src/index.ts"],
      "@research-workbench/core": ["apps/core/src/index.ts"]
    },
    "types": ["node"]
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist", "out"]
}
