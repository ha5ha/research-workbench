{
  "name": "@research-workbench/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Research Workbench desktop shell",
  "author": "Research Workbench",
  "main": "./out/main/index.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "package": "electron-builder --win portable",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lsp-client": "^6.3.0",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@research-workbench/contracts": "workspace:*",
    "codemirror": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.researchworkbench.desktop",
    "productName": "Research Workbench",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/core",
        "to": "core"
      },
      {
        "from": "resources/skills",
        "to": "skills"
      },
      {
        "from": "resources/fixtures",
        "to": "fixtures"
      },
      {
        "from": "resources/templates",
        "to": "templates"
      },
      {
        "from": "resources/lsp",
        "to": "lsp"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "artifactName": "ResearchWorkbench-${version}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
